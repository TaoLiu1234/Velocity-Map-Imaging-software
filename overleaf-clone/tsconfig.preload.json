{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-electron",
    "rootDir": ".",
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["preload/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-electron", "src", "tools", "electron"]
}
